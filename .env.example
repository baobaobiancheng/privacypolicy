DATABASE_URL="mysql://root:password@127.0.0.1:3306/privacy_policy"
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-v4-pro"
DEEPSEEK_MAX_TOKENS="131072"
# 正文流式生成的最长总时间；只要持续收到模型响应，不会被旧的 240 秒限制中断。
DEEPSEEK_GENERATION_TIMEOUT_MS="1200000"
# 开发期新建项目自动载入完整地图示例；设为 false 即恢复空白表单。生产构建始终不启用。
NEXT_PUBLIC_DEV_FORM_DEFAULTS="true"
BAIJIAN_APP_KEY=""
BAIJIAN_APP_SECRET=""
# Worker 空闲时查询待执行任务的间隔。Web 与 Worker 必须连接同一个 MySQL。
GENERATION_WORKER_POLL_MS="1500"
# 仅测试时启用；集成测试会创建并删除独立的临时数据库，不会清空 DATABASE_URL 指向的库。
RUN_MYSQL_INTEGRATION="0"
TEST_DATABASE_URL=""
