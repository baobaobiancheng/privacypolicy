generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  CLIENT_EDITOR
  PRODUCT_TECH
  ADMIN
}

enum ProjectStatus {
  INFORMATION_COLLECTING
  ACTIVE
  STOPPED
}

enum GenerationJobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  SUPERSEDED
}

enum GenerationStage {
  QUEUED
  FACT_CHECK
  LAW_SEARCH
  DRAFTING
  FINALIZING
  COMPLETED
}

enum ReportState {
  CURRENT
  SUPERSEDED
}

enum ReportStorageKind {
  MYSQL
  OBJECT_STORAGE
}

model User {
  id              String           @id @db.VarChar(64)
  tenantId        String           @db.VarChar(64)
  email           String?          @db.VarChar(255)
  displayName     String           @db.VarChar(120)
  role            UserRole
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  projects        Project[]        @relation("ProjectOwner")
  access          ProjectAccess[]
  generationJobs  GenerationJob[]  @relation("GenerationRequestedBy")
  auditEvents     AuditEvent[]
  analyticsEvents AnalyticsEvent[]

  @@index([tenantId, role])
  @@map("users")
}

model Project {
  id                String           @id @db.VarChar(64)
  tenantId          String           @db.VarChar(64)
  ownerId           String           @db.VarChar(64)
  creationKey       String?          @db.VarChar(128)
  name              String           @db.VarChar(160)
  productName       String?          @db.VarChar(160)
  status            ProjectStatus    @default(INFORMATION_COLLECTING)
  revision          Int              @default(0)
  formSchemaVersion String           @default("privacy-form-v2.0.0") @db.VarChar(64)
  contentVersion    String           @db.VarChar(64)
  contentHash       String           @db.Char(71)
  categoryKey       String           @default("map-navigation") @db.VarChar(64)
  categoryVersion   String           @default("app-categories-v1.0.0") @db.VarChar(64)
  currentStepKey    String           @default("profile") @db.VarChar(64)
  progressPercent   Int              @default(0)
  formData          Json
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  owner             User             @relation("ProjectOwner", fields: [ownerId], references: [id])
  access            ProjectAccess[]
  generationJobs    GenerationJob[]
  reports           Report[]
  auditEvents       AuditEvent[]
  analyticsEvents   AnalyticsEvent[]

  @@unique([tenantId, ownerId, creationKey])
  @@index([tenantId, status, updatedAt])
  @@index([tenantId, createdAt])
  @@index([ownerId, updatedAt])
  @@index([tenantId, categoryKey])
  @@map("projects")
}

model ProjectAccess {
  id        String   @id @db.VarChar(64)
  projectId String   @db.VarChar(64)
  userId    String   @db.VarChar(64)
  role      UserRole
  grantedBy String   @db.VarChar(64)
  grantedAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, projectId])
  @@map("project_access")
}

/// Generation lifecycle:
/// QUEUED -> RUNNING -> SUCCEEDED
///                    -> FAILED
///                    -> SUPERSEDED (project revision changed during generation)
/// Expired RUNNING leases may be reclaimed by another worker. Idempotency is
/// enforced per project so browser retries never create duplicate work.
model GenerationJob {
  id              String             @id @db.VarChar(64)
  projectId       String             @db.VarChar(64)
  requestedById   String             @db.VarChar(64)
  projectRevision Int
  idempotencyKey  String             @db.VarChar(128)
  inputHash       String             @db.Char(71)
  activeInputKey  String?            @unique @db.Char(71)
  inputJson       Json
  state           GenerationJobState @default(QUEUED)
  stage           GenerationStage    @default(QUEUED)
  progressJson    Json?
  previewMarkdown String?            @db.LongText
  errorCode       String?            @db.VarChar(80)
  errorMessage    String?            @db.Text
  errorDetails    Json?
  attemptCount    Int                @default(0)
  nextAttemptAt   DateTime           @default(now())
  leaseOwner      String?            @db.VarChar(128)
  leaseExpiresAt  DateTime?
  heartbeatAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requestedBy     User               @relation("GenerationRequestedBy", fields: [requestedById], references: [id])
  report          Report?

  @@unique([projectId, idempotencyKey])
  @@index([state, leaseExpiresAt, createdAt])
  @@index([state, nextAttemptAt, leaseExpiresAt, createdAt], map: "generation_jobs_state_next_attempt_lease_idx")
  @@index([projectId, createdAt])
  @@index([projectId, state, completedAt])
  @@map("generation_jobs")
}

model Report {
  id              String            @id @db.VarChar(64)
  projectId       String            @db.VarChar(64)
  generationId    String            @unique @db.VarChar(64)
  projectRevision Int
  inputHash       String            @db.Char(71)
  state           ReportState       @default(CURRENT)
  filename        String            @db.VarChar(255)
  markdown        String            @db.LongText
  storageKind     ReportStorageKind @default(MYSQL)
  storageKey      String?           @db.VarChar(512)
  docx            Bytes?            @db.LongBlob
  docxHash        String            @db.Char(71)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generation      GenerationJob     @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([projectId, state, createdAt])
  @@map("reports")
}

model AuditEvent {
  id        String   @id @db.VarChar(64)
  requestId String?  @db.VarChar(64)
  projectId String?  @db.VarChar(64)
  userId    String?  @db.VarChar(64)
  action    String   @db.VarChar(120)
  metadata  Json?
  createdAt DateTime @default(now())
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([projectId, action, createdAt])
  @@index([requestId])
  @@map("audit_events")
}

/// Product analytics intentionally stores operational metadata only. Customer
/// form values, assistant prompts, attachment text and policy content must
/// never be copied into this table.
model AnalyticsEvent {
  id         String   @id @db.VarChar(64)
  tenantId   String   @db.VarChar(64)
  userId     String   @db.VarChar(64)
  projectId  String?  @db.VarChar(64)
  sessionId  String?  @db.VarChar(64)
  eventName  String   @db.VarChar(64)
  pagePath   String?  @db.VarChar(500)
  durationMs Int?
  properties Json?
  occurredAt DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([tenantId, eventName, occurredAt])
  @@index([occurredAt])
  @@index([projectId, occurredAt])
  @@index([userId, occurredAt])
  @@index([sessionId, occurredAt])
  @@map("analytics_events")
}
